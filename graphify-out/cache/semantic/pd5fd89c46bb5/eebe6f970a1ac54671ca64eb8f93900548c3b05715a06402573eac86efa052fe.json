{"nodes": [{"id": "distribucion", "label": "DISTRIBUCION.md - Installer & Modules Guide", "file_type": "document", "source_file": "DISTRIBUCION.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "distribucion_launcher_installer", "label": "Launcher / Installer (launcher/)", "file_type": "concept", "source_file": "DISTRIBUCION.md", "source_location": "L3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The .exe is only a launcher; module code lives on the server so modules can be updated without redistributing the .exe."}, {"id": "distribucion_license_session", "label": "License Login & Session Token", "file_type": "concept", "source_file": "DISTRIBUCION.md", "source_location": "L9", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Downloads require a license session; suspended/expired licenses or licenses not including a module are refused."}, {"id": "distribucion_overlayracing_server", "label": "Server overlayracing.site", "file_type": "concept", "source_file": "DISTRIBUCION.md", "source_location": "L5", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "distribucion_module_download_api", "label": "Module Download API (/api/public/modules/<id>/latest, /download/<version>)", "file_type": "concept", "source_file": "DISTRIBUCION.md", "source_location": "L11", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "distribucion_ed25519_package_signing", "label": "Ed25519 Package Signing (RELEASE_SIGNING_KEY / release-public-key.pem)", "file_type": "rationale", "source_file": "DISTRIBUCION.md", "source_location": "L20", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Server signs each package with a private key and the launcher ships the public key; packages without a valid signature are never executed."}, {"id": "distribucion_module_start_ctx_contract", "label": "Module Contract: module.json + main.cjs start(ctx)", "file_type": "rationale", "source_file": "DISTRIBUCION.md", "source_location": "L14", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every module is a package with module.json (id, version) and main.cjs exporting start(ctx), required by the launcher after extraction."}, {"id": "distribucion_launcherapi_versioning", "label": "launcherApi Version Compatibility", "file_type": "rationale", "source_file": "DISTRIBUCION.md", "source_location": "L19", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Shared libraries (express, socket.io, puppeteer, xlsx, Chromium) ship in the launcher; a module needing a new library declares a higher launcherApi so old launchers ask the user to update."}, {"id": "distribucion_optional_updates", "label": "Optional Module Updates", "file_type": "rationale", "source_file": "DISTRIBUCION.md", "source_location": "L22", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Updates are never forced ('Actualizar y abrir' / 'Abrir sin actualizar') so the installed version works offline; only the first install requires download."}, {"id": "distribucion_module_pack_publish", "label": "npm run module:pack / module:publish", "file_type": "concept", "source_file": "DISTRIBUCION.md", "source_location": "L33", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Detects modified modules via Git, builds ZIPs and publishes with admin credentials from .env (OVERLAY_ADMIN_USER/PASSWORD)."}, {"id": "distribucion_module_catalog", "label": "MODULE_CATALOG (backend/src/licensePlans.js)", "file_type": "concept", "source_file": "DISTRIBUCION.md", "source_location": "L55", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "New modules are registered server-side in the web project; until a version is published the client shows them as 'Pr\u00f3ximamente'."}, {"id": "distribucion_football_module", "label": "Football Module (manual data, football-data.json)", "file_type": "concept", "source_file": "DISTRIBUCION.md", "source_location": "L59", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No data provider: teams, squad, staff, crests, score and clock are entered manually and stored in football-data.json."}, {"id": "distribucion_football_five_leagues", "label": "Five League Styles (Bundesliga, Premier League, LaLiga, Liga Argentina, MLS)", "file_type": "concept", "source_file": "DISTRIBUCION.md", "source_location": "L63", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "distribucion_football_graphics", "label": "Football Graphics (scoreboard+clock, lineup, match presentation, goal/sub/card alert)", "file_type": "concept", "source_file": "DISTRIBUCION.md", "source_location": "L62", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "distribucion_personalizar_tab", "label": "PERSONALIZAR Tab (per-graphic customization)", "file_type": "concept", "source_file": "DISTRIBUCION.md", "source_location": "L66", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "distribucion_overlay_browser_source", "label": "Overlay Output (chroma window or http://<IP>:8080/#/overlay for OBS/vMix)", "file_type": "concept", "source_file": "DISTRIBUCION.md", "source_location": "L71", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "distribucion_nsis_installer", "label": "NSIS Installer (npm run dist, electron-builder)", "file_type": "concept", "source_file": "DISTRIBUCION.md", "source_location": "L78", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "NSIS chosen over portable .exe because portable extraction to temp on every run triggers antivirus suspicion; asInvoker per-user install, bundles scraper Chromium so it works without Node/Chrome/Edge."}, {"id": "distribucion_smartscreen_code_signing", "label": "Windows SmartScreen & Code Signing (CSC_LINK, EV/OV certs)", "file_type": "rationale", "source_file": "DISTRIBUCION.md", "source_location": "L85", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SmartScreen warns on any unsigned exe; only a code-signing certificate removes it (EV immediately, OV after reputation accrues)."}], "edges": [{"source": "distribucion", "target": "distribucion_launcher_installer", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "DISTRIBUCION.md", "source_location": "L3", "weight": 1.0}, {"source": "distribucion_launcher_installer", "target": "distribucion_license_session", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "DISTRIBUCION.md", "source_location": "L9", "weight": 1.0}, {"source": "distribucion_launcher_installer", "target": "distribucion_module_download_api", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "DISTRIBUCION.md", "source_location": "L11", "weight": 1.0}, {"source": "distribucion_module_download_api", "target": "distribucion_overlayracing_server", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "DISTRIBUCION.md", "source_location": "L5", "weight": 1.0}, {"source": "distribucion_ed25519_package_signing", "target": "distribucion_launcher_installer", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "DISTRIBUCION.md", "source_location": "L20", "weight": 1.0}, {"source": "distribucion_launcher_installer", "target": "distribucion_module_start_ctx_contract", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "DISTRIBUCION.md", "source_loca