{
  "name": "overlay-racing",
  "private": true,
  "version": "1.1.1",
  "type": "module",
  "main": "launcher/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron:dev": "wait-on http://localhost:5173 && electron .",
    "start": "concurrently -k \"npm run dev\" \"npm run football:dev\" \"npm run electron:dev\"",
    "football:dev": "vite --config football/vite.config.js",
    "football:build": "vite build --config football/vite.config.js",
    "football:pack": "node scripts/pack-module.cjs football",
    "football:publish": "node scripts/publish-module.cjs football",
    "dist": "node scripts/bundle-chromium.cjs && electron-builder --win nsis",
    "dist:portable": "node scripts/bundle-chromium.cjs && electron-builder --win portable",
    "module:pack": "node scripts/pack-module.cjs",
    "module:publish": "node scripts/publish-module.cjs"
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "express": "^5.2.1",
    "puppeteer": "^25.8.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "untun": "^0.2.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^43.4.1",
    "electron-builder": "^24.13.3",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "vite": "^8.2.2",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.productora.overlay",
    "productName": "Overlay Studio",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "src/assets/icon.ico",
      "requestedExecutionLevel": "asInvoker",
      "legalTrademarks": "Overlay Studio"
    },
    "asarUnpack": [
      "**/node_modules/puppeteer/**/*",
      "**/node_modules/@puppeteer/**/*"
    ],
    "extraResources": [
      {
        "from": "chromium",
        "to": "chromium"
      }
    ],
    "copyright": "Copyright © Overlay Studio",
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "perMachine": false,
      "language": "3082",
      "installerIcon": "src/assets/icon.ico",
      "uninstallerIcon": "src/assets/icon.ico",
      "installerHeaderIcon": "src/assets/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Overlay Studio",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "Overlay-Studio-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Overlay-Studio-Portable-${version}.${ext}"
    },
    "files": [
      "launcher/**/*",
      "package.json"
    ]
  },
  "description": "Overlay Studio: instalador con los módulos del software (carrera, ...), que se descargan del servidor según la licencia",
  "author": {
    "name": "Roman Manuel Borla"
  }
}
