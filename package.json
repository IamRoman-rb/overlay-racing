{
  "name": "overlay-racing",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron:dev": "wait-on http://localhost:5173 && electron .",
    "start": "concurrently -k \"npm run dev\" \"npm run electron:dev\"",
    "dist": "npm run build && node scripts/bundle-chromium.cjs && electron-builder --win nsis",
    "dist:portable": "npm run build && node scripts/bundle-chromium.cjs && electron-builder --win portable"
  },
  "dependencies": {
    "express": "^5.2.1",
    "puppeteer": "^25.8.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "untun": "^0.2.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^43.4.1",
    "electron-builder": "^24.13.3",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "vite": "^8.2.2",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.productora.overlay",
    "productName": "Race Dynamics",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "src/assets/icon.ico",
      "requestedExecutionLevel": "asInvoker",
      "legalTrademarks": "Race Dynamics"
    },
    "asarUnpack": [
      "**/node_modules/puppeteer/**/*",
      "**/node_modules/@puppeteer/**/*"
    ],
    "extraResources": [
      {
        "from": "chromium",
        "to": "chromium"
      }
    ],
    "copyright": "Copyright © Race Dynamics",
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "Race-Dynamics-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Race-Dynamics-Portable-${version}.${ext}"
    }
  },
  "description": "Race Dynamics: overlay y panel de control para transmisiones de automovilismo",
  "author": {
    "name": "Race Dynamics"
  }
}
